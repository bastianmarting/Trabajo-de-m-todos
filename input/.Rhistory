# Identificar los datos observados y la proyección
datos$tipo <- ifelse(
datos$year == 2026,
"Proyección",
"Observado"
)
# Etiquetas del eje horizontal
datos$year_label <- ifelse(
datos$year == 2026,
"2026*",
as.character(datos$year)
)
# Mantener el orden cronológico
datos$year_label <- factor(
datos$year_label,
levels = datos$year_label
)
# Gráfico
grafico <- ggplot(
datos,
aes(x = year_label, y = volumen, fill = tipo)
) +
geom_col(width = 0.76) +
geom_text(
aes(label = format(volumen, trim = TRUE, scientific = FALSE)),
vjust = -0.45,
size = 3.6,
color = "#172A3A"
) +
scale_fill_manual(
values = c(
"Observado" = "#2A5260",
"Proyección" = "#4E3239"
)
) +
scale_y_continuous(
breaks = seq(0, 250, 50),
limits = c(0, 245),
expand = expansion(mult = c(0, 0))
) +
labs(
title = "El volumen global de datos crece aceleradamente",
subtitle = "Volumen anual de datos, 2010–2026 (zettabytes)",
x = NULL,
y = "Zettabytes",
caption = "* 2026 corresponde a una proyección.\nFuente: Statista.",
fill = NULL
) +
theme_minimal(base_family = "Arial", base_size = 14) +
theme(
plot.background = element_rect(
fill = "white",
color = NA
),
panel.background = element_rect(
fill = "white",
color = NA
),
plot.title = element_text(
size = 23,
face = "bold",
color = "#172A3A",
margin = margin(b = 7)
),
plot.subtitle = element_text(
size = 15,
color = "#455A64",
margin = margin(b = 18)
),
axis.text.x = element_text(
size = 10.5,
color = "#172A3A",
angle = 45,
hjust = 1
),
axis.text.y = element_text(
size = 11,
color = "#455A64"
),
axis.title.y = element_text(
size = 12,
color = "#172A3A",
margin = margin(r = 10)
),
panel.grid.major.x = element_blank(),
panel.grid.minor = element_blank(),
panel.grid.major.y = element_line(
color = "#E8EEF0",
linewidth = 0.6
),
axis.line.x = element_line(
color = "#B9C6CB",
linewidth = 0.5
),
legend.position = "none",
plot.caption = element_text(
size = 9.5,
color = "#6F828B",
hjust = 0,
margin = margin(t = 15)
),
plot.margin = margin(20, 28, 18, 20)
)
grafico
setwd("~/Dropbox/Universidad de Chile/Pregrado/2026/Introducción a la Ciencia Social Computacional y Experimental/Presentaciones y materiales del curso/Sesión 09")
#
#  Sesión 09 · Análisis computacional de textos II
#  Inducir o definir: modelos de tópicos (data-first) y diccionarios (theory-first)
#  Corpus: mensajes presidenciales de Allende (1971-1973) y Pinochet (1974-1980)
#  Introducción a la Ciencia Social Computacional y Experimental · 2026
#
#  Cómo usar este guion
#  1. Trabaje en la MISMA carpeta que usó en la Sesión 08. Ahí deben estar:
#       - el archivo "dtm_mensajes_parrafos.rds" (lo guardó al final del guion 08)
#       - la carpeta "Corpus Allende-Pinochet" con los diez .txt
#         (la que descomprimieron en la Sesión 08, de "1971 Allende.txt"
#         a "1980 Pinochet.txt")
#     En RStudio: Session > Set Working Directory > Choose Directory...
#  2. Corra el guion paso a paso (Ctrl/Cmd + Enter). Cada PASO
#     corresponde a una lámina de los bloques 3 y 4.
#  3. El PASO 7 (opcional) usa además la carpeta "Corpus" de la Sesión 09
#     (195 cuentas públicas, 1832-2026). Cópiela en la misma carpeta.
#
# ---- PASO 0 · Paquetes ------------------------------------------------
# Solo hay uno nuevo: seededlda (modelos de tópicos que leen la matriz de quanteda)
# install.packages("seededlda")
library(quanteda)            # corpus, tokens, matriz, diccionarios
library(seededlda)           # textmodel_lda(): el modelo de tópicos
library(readtext)            # solo para volver a leer los párrafos (paso 1b)
getwd()                                   # ¿estoy en la carpeta correcta?
file.exists("dtm_mensajes_parrafos.rds")  # debe decir TRUE
# ---- PASO 1 · Recuperar la matriz de la Sesión 08 --------------------
# a) La matriz documento-término: 1.279 párrafos x 1.647 palabras
dtm <- readRDS("dtm_mensajes_parrafos.rds")
dtm
head(docvars(dtm))                     # cada párrafo sabe su presidente y año
table(docvars(dtm, "presidente"))      # 1.022 de Allende y 257 de Pinochet
# b) Los textos de los párrafos, para poder LEERLOS después.
#    La matriz ya no tiene el texto (es una bolsa de palabras), así que
#    repetimos en pocas líneas los pasos 1 a 3 del guion 08.
archivos <- list.files("Corpus Allende-Pinochet", pattern = "\\.txt$",
recursive = TRUE, full.names = TRUE)
mensajes <- readtext(archivos, encoding = "UTF-8")
mensajes$anio <- as.integer(substr(mensajes$doc_id, 1, 4))
mensajes$presidente <- ifelse(mensajes$anio <= 1973, "Allende", "Pinochet")
mensajes$text <- gsub("([[:alpha:]])-\\s*\n\\s*", "\\1", mensajes$text)
mensajes$text <- gsub("[ \t]+", " ", mensajes$text)
corp <- corpus(mensajes)
docnames(corp) <- paste(corp$presidente, corp$anio, sep = "_")
corp_par <- corpus_reshape(corp, to = "paragraphs")
corp_par <- corpus_subset(corp_par, ntoken(corp_par) >= 10)
corp_par <- corpus_subset(corp_par, grepl("[a-záéíóúñ]", corp_par))
# Control: los párrafos y las filas de la matriz deben ser los mismos
identical(docnames(corp_par), docnames(dtm))   # debe decir TRUE
# ---- PASO 2 · Estimar un modelo de tópicos (LDA) ---------------------
# Le decimos SOLO cuántos tópicos buscar (k). Qué significan, lo decidimos después.
set.seed(2026)                       # el modelo tiene azar: fijamos la semilla
lda <- textmodel_lda(dtm, k = 8)     # unos 10 segundos
# Guardar el modelo recién estimado. Es lo que se comparte para que otros
# lean EXACTAMENTE estos tópicos con readRDS(), sin volver a estimarlos.
# (Profesor: suba este archivo a u-cursos antes de la clase.)
saveRDS(lda, "lda_k8.rds")
sessionInfo()   # sistema operativo y versiones de R y de los paquetes: se informan junto al modelo
# ¿Sus tópicos no coinciden con los de la lámina? Con la misma semilla, Mac y
# Windows dan resultados distintos (el azar se genera en C++ y cada sistema usa
# otro generador). Para trabajar todos con el MISMO modelo, descargue
# "lda_k8.rds" de u-cursos, póngalo en esta carpeta y, EN LUGAR de las líneas
# set.seed(), textmodel_lda() y saveRDS() de arriba, corra sólo esta:
# lda <- readRDS("lda_k8.rds")
# (¡Ojo! Si corre el saveRDS() de arriba, reemplaza el archivo del profesor
#  por su propio modelo. Si le pasó, vuelva a descargarlo.)
# Las 10 palabras más probables de cada tópico (tabla "phi": tópico x palabra)
terms(lda, 10)
# ---- PASO 3 · Interpretar: ponerle nombre, ver quién lo usa y LEER ---
# a) Nuestros nombres para los tópicos (¡son una interpretación, no un dato!)
#    Si su corrida salió en otro orden, reordene estos nombres.
nombres <- c("Régimen y transformación", #topic1
"Participación de trabajadores", #topic2
"Reformas y redistribución", #topic3
"Desarrollo regional", #topic4
"Salud, educación y cifras", #topic5
"Política exterior", #topic6
"Producción y cobre", #topic7
"Chile: nación y patria" #topic8
)
# b) La tabla "theta": cuánto de cada tópico tiene cada párrafo (suma 1 por fila)
theta <- lda$theta
round(head(theta), 2)
# c) Tópico principal de cada párrafo, por presidente (asigna a cada párrafo
# el tópico con mayor θ, es decir, "su" tópico principal)
table(nombres[topics(lda)], docvars(dtm, "presidente"))
# d) Peso promedio de cada tópico por presidente (en %)
#    aggregate() promedia theta por presidente. Deja los presidentes en la
#    primera columna; los pasamos a nombres de fila para no perderlos al
#    quitar esa columna con [, -1]
prevalencia <- aggregate(theta, by = list(presidente = docvars(dtm, "presidente")),
FUN = mean)
rownames(prevalencia) <- prevalencia$presidente   # Allende y Pinochet como nombres de fila
# Con topic1, topic2... (para comparar con terms(lda))
round(t(prevalencia[, -1]) * 100, 1)
# Con los nombres que les pusimos a los tópicos
colnames(prevalencia)[-1] <- nombres
round(t(prevalencia[, -1]) * 100, 1)
barplot(as.matrix(prevalencia[, -1]) * 100, beside = TRUE,
col = c("#2A5260", "#4E3239"), las = 2, cex.names = 0.7,
ylab = "% promedio del párrafo", legend.text = prevalencia$presidente)
# e) LEER los dos párrafos más típicos de un tópico (aquí, el 8; pruebe 7, 5 y 3)
k <- 8
tipicos <- order(theta[, k], decreasing = TRUE)[1:2]
rownames(theta)[tipicos]                      # cuáles son
as.character(corp_par)[rownames(theta)[tipicos]]  # su texto completo
# ---- PASO 4 · ¿Qué tan estable es el resultado? ----------------------
# Cambiemos UNA decisión a la vez y comparemos con el paso 2.
# a) Otra semilla: los tópicos se parecen, pero cambian de número y algunos se mezclan
set.seed(1)
lda_s1 <- textmodel_lda(dtm, k = 8)
terms(lda_s1, 6)
# b) Otro número de tópicos
set.seed(2026)
lda_k6 <- textmodel_lda(dtm, k = 6)
terms(lda_k6, 6)
# c) Más tópicos: ¿qué tópico se divide en dos?
set.seed(2026)
lda_k10 <- textmodel_lda(dtm, k = 10)
terms(lda_k10, 6)
#  Pruebe también k = 12.
table(nombres[topics(lda)], docvars(dtm, "presidente"))
prevalencia <- aggregate(theta, by = list(presidente = docvars(dtm, "presidente")),
FUN = mean)
rownames(prevalencia) <- prevalencia$presidente   # Allende y Pinochet como nombres de fila
# Con topic1, topic2... (para comparar con terms(lda))
round(t(prevalencia[, -1]) * 100, 1)
# Lo mismo de arriba, pero con los nombres que les pusimos a los tópicos
colnames(prevalencia)[-1] <- nombres
round(t(prevalencia[, -1]) * 100, 1)
#Gráfico de barras con la información anterior
barplot(as.matrix(prevalencia[, -1]) * 100, beside = TRUE,
col = c("#2A5260", "#4E3239"), las = 1, cex.names = 0.7,
ylab = "% promedio del párrafo", legend.text = prevalencia$presidente)
#Gráfico de barras con la información anterior
barplot(as.matrix(prevalencia[, -1]) * 100, beside = TRUE,
col = c("#2A5260", "#4E3239"), las = 2, cex.names = 0.5,
ylab = "% promedio del párrafo", legend.text = prevalencia$presidente)
# d) ¿Qué tópico de lda corresponde a cuál de lda_s1? Comparar listas de
#    palabras a ojo es lento; mejor medir cuánto se parecen.
#    - Cada tópico es una fila de la tabla phi: la probabilidad de cada una de
#      las 1.647 palabras. Dos tópicos se parecen si dan probabilidades altas
#      a las mismas palabras.
#    - La similitud coseno mide ese parecido: 1 = misma composición de
#      palabras, 0 = nada en común. Es la misma medida que usan Arvidsson,
#      Hedström y Keuschnigg (2025, p. 725) para medir cuánto se traslapan
#      los gustos musicales de Ego y Alter: comparan sus vectores de
#      proporciones de tópicos (theta), como aquí comparamos tópicos (phi).
#    - proxyC::simil() calcula la similitud de cada tópico de un modelo con
#      cada tópico del otro (proxyC viene instalado con seededlda). as(...,
#      "dgCMatrix") sólo cambia el formato de la tabla al que pide la función.
similitud <- proxyC::simil(as(lda$phi, "dgCMatrix"), as(lda_s1$phi, "dgCMatrix"),
method = "cosine")
round(as.matrix(similitud), 2)   # filas: tópicos de lda; columnas: de lda_s1
s <- as.matrix(similitud)
data.frame(topico = nombres, par_en_s1 = colnames(s)[apply(s, 1, which.max)],
similitud = round(apply(s, 1, max), 2))
# ---- PASO 5 · Definir el diccionario y contar ------------------------
# Cada lista es una hipótesis: "estas palabras indican este marco".
# El * es un comodín: "socialis*" = socialismo, socialista, socialistas...
dic <- dictionary(list(
transformacion = c("socialis*", "revoluc*", "capitalis*", "explota*", "clase",
"clases", "monopol*", "imperialis*", "latifund*", "oligarq*",
"liberación", "nacionalización", "transformaci*",
"unidad_popular", "gobierno_popular", "área_de_propiedad_social"),
orden          = c("patria", "orden", "seguridad", "fuerzas_armadas",
"junta_de_gobierno", "reconstrucción", "caos", "disciplina",
"soberan*", "autoridad*", "subversi*", "marxis*"),
mercado        = c("mercado*", "privad*", "inversión", "inversiones", "competencia",
"eficien*", "iniciativa*", "libertad", "moderniza*",
"subsidiari*", "empresarios")))
dic
# ¿Qué palabras de la matriz cayeron en cada marco? (¡revíselo siempre!)
dfm_select(dtm, pattern = dic["orden"]) |> colSums() |> sort(decreasing = TRUE)
# Contar: cada párrafo pasa de 1.647 columnas a 3 (una por marco)
marcos <- dfm_lookup(dtm, dictionary = dic)
marcos[1:5, ]
# Por cada 1.000 palabras, para que el largo no engañe (como en la Sesión 08)
por_pres <- dfm_group(marcos, groups = presidente)
total_pres <- ntoken(dfm_group(dtm, groups = presidente))
round(as.matrix(por_pres) / total_pres * 1000, 1)
por_anio <- dfm_group(marcos, groups = anio)
total_anio <- ntoken(dfm_group(dtm, groups = anio))
tasa <- as.matrix(por_anio) / total_anio * 1000
round(tasa, 1)
anios <- as.integer(rownames(tasa))
matplot(anios, tasa, type = "b", pch = 19, lty = 1,
col = c("#4E3239", "#2A5260", "#9FB4BD"), xaxt = "n",
xlab = "Año", ylab = "Palabras del marco por cada 1.000")
axis(1, at = anios, labels = anios)
legend("topright", colnames(tasa), col = c("#4E3239", "#2A5260", "#9FB4BD"),
lty = 1, pch = 19)
abline(v = 1973.5, lty = 2)
# ---- PASO 6 · Validar: leer lo que estamos contando -------------------
# Un diccionario no entiende: cuenta. Volvemos a la lectura cercana.
toks <- tokens(corp_par, remove_punct = TRUE) |> tokens_tolower() |>
tokens_compound(phrase(c("unidad popular", "fuerzas armadas", "gobierno popular",
"junta de gobierno", "área de propiedad social")))
View(toks)
# a) "seguridad" en Allende: ¿marco de orden?
kwic(tokens_subset(toks, presidente == "Allende"), "seguridad", window = 4) |> head(10)
# a) "seguridad" en Allende: ¿marco de orden?
kwic(tokens_subset(toks, presidente == "Allende"), "seguridad", window = 5) |> head(10)
# b) "liberación" en Pinochet: ¿marco de transformación?
kwic(tokens_subset(toks, presidente == "Pinochet"), "liberación", window = 4)
# c) "orden" en ambos: ¿orden público u "orden de magnitud"?
kwic(toks, "orden", window = 4) |> head(15)
# d) Una muestra al azar para codificar a mano (Actividad 3)
set.seed(9)
muestra <- kwic(toks, dic["orden"], window = 5)
muestra[sample(nrow(muestra), 10), ]
# e) Diccionario corregido: sacamos "seguridad" del marco de orden y
#    "liberación" del de transformación. ¿Cuánto cambia la comparación?
lista <- as.list(dic)
lista$orden <- setdiff(lista$orden, "seguridad")
lista$transformacion <- setdiff(lista$transformacion, "liberación")
dic2 <- dictionary(lista)
por_pres2 <- dfm_group(dfm_lookup(dtm, dic2), groups = presidente)
round(as.matrix(por_pres2) / total_pres * 1000, 1)
# b) "liberación" en Pinochet: ¿marco de transformación?
kwic(tokens_subset(toks, presidente == "Pinochet"), "liberación", window = 4)
setwd("~/Dropbox/Universidad de Chile/Pregrado/2026/Introducción a la Ciencia Social Computacional y Experimental/Presentaciones y materiales del curso/Sesión 10/Materiales Taller 3")
# ---- PASO 0 · Paquetes -------------------------------------------------
# Los mismos de las sesiones 8, 9 y 10. Si falta alguno, quite el # y corra UNA vez:
# install.packages(c("quanteda", "seededlda", "readtext", "quanteda.textplots"))
library(quanteda)
library(seededlda)
library(readtext)
library(quanteda.textplots)
getwd()                                              # ¿estoy en "Taller 3"?
length(list.files("Cuentas 1990-2026", pattern = "\\.txt$"))   # debe decir 37
file.exists("metadatos_cuentas_1990_2026.csv")       # debe decir TRUE
# ---- PASO 1 · Leer las cuentas y sus metadatos --------------------------
archivos <- list.files("Cuentas 1990-2026", pattern = "\\.txt$", full.names = TRUE)
cuentas  <- readtext(archivos, encoding = "UTF-8")
# Metadatos: una fila por cuenta pública (año, presidente, gobierno, coalición,
# sector, n° de cuenta dentro del mandato, si es la primera y n° de palabras)
meta <- read.csv("metadatos_cuentas_1990_2026.csv", encoding = "UTF-8")
head(meta)
# Unimos texto y metadatos por el nombre del archivo
cuentas <- merge(cuentas, meta, by.x = "doc_id", by.y = "archivo")
cuentas$text <- gsub("([[:alpha:]])-\\s*\n\\s*", "\\1", cuentas$text)  # palabras cortadas con guion
cuentas$text <- gsub("[ \t]+", " ", cuentas$text)                       # espacios dobles
# El orden de los gobiernos (para que las tablas y gráficos salgan en orden histórico)
orden_gob <- c("Aylwin", "Frei", "Lagos", "Bachelet I", "Piñera I",
"Bachelet II", "Piñera II", "Boric", "Kast")
corp <- corpus(cuentas)
docnames(corp) <- paste(corp$gobierno, corp$anio, sep = "_")
corp_par <- corpus_reshape(corp, to = "paragraphs")
corp_par <- corpus_subset(corp_par, ntoken(tokens(corp_par)) >= 10)  # fuera párrafos < 10 palabras
corp_par <- corpus_subset(corp_par, grepl("[a-záéíóúñ]", corp_par))  # fuera títulos en mayúsculas
ndoc(corp_par)                                      # unos 11.150 párrafos
table(factor(corp_par$gobierno, levels = orden_gob))  # ¡ojo! Kast tiene muy pocos (una sola cuenta)
texto <- as.character(corp_par)                     # el texto de cada párrafo, para leer
# Expresiones de varias palabras que tratamos como una sola (agregue las suyas)
compuestos <- c("derechos humanos", "crimen organizado", "fuerzas armadas",
"seguridad social", "seguridad pública", "seguridad ciudadana",
"derechos sociales", "clase media", "medio ambiente",
"cambio climático", "crisis climática", "pueblos originarios",
"pueblos indígenas", "estallido social", "estado de derecho",
"orden público", "detenidos desaparecidos", "protección social",
"crecimiento económico", "nueva constitución", "libre mercado")
toks <- tokens(corp_par, remove_punct = TRUE, remove_numbers = TRUE,
remove_symbols = TRUE) |>
tokens_tolower() |>
tokens_compound(phrase(compuestos))
toks_sin <- tokens_remove(toks, stopwords("es"))
dtm <- dfm(toks_sin)
dtm <- dfm_trim(dtm, min_termfreq = 5)   # palabras que aparecen 5 o más veces
dtm                                      # unos 11.150 párrafos x 7.200 palabras
topfeatures(dtm, 30)
# ---- PASO 3 · Elegir la pregunta y su diccionario de semillas ----------
# Hay cuatro preguntas. Cada grupo elige UNA (ver la pauta). Cada diccionario es
# una hipótesis: "estas palabras indican este concepto". Pueden AGREGAR o QUITAR
# palabras (máximo 5 cambios por lista), pero deben justificarlo en el informe.
# A. ¿Volvió el lenguaje de Allende?  (el mismo diccionario de las sesiones 9 y 10)
dic_A <- dictionary(list(
transformacion = c("socialis*", "revoluc*", "capitalis*", "explota*", "clase",
"clases", "monopol*", "imperialis*", "latifund*", "oligarq*",
"liberación", "nacionalización", "transformaci*",
"unidad_popular", "gobierno_popular", "área_de_propiedad_social"),
orden          = c("patria", "orden", "seguridad", "fuerzas_armadas",
"junta_de_gobierno", "reconstrucción", "caos", "disciplina",
"soberan*", "autoridad*", "subversi*", "marxis*"),
mercado        = c("mercado*", "privad*", "inversión", "inversiones", "competencia",
"eficien*", "iniciativa*", "libertad", "moderniza*",
"subsidiari*", "empresarios")))
dic <- dic_A          # >>> CAMBIAR AQUÍ <<<  dic_A, dic_B, dic_C o dic_D
marcos <- names(dic)  # los nombres de sus tópicos sembrados
dic
# ¿Qué palabras de la matriz calzan con cada lista? ¡Revíselo siempre!
# Si una semilla tiene 0 apariciones, no sirve: cámbiela.
for (m in marcos) {
cat("\n", m, "\n")
print(sort(colSums(dfm_select(dtm, pattern = dic[m])), decreasing = TRUE))
}
semillas <- featnames(dfm_select(dtm, pattern = dic))
# ---- PASO 4 · Estimar el modelo de tópicos semillado --------------------
# residual = 15: además de sus tópicos sembrados, 15 tópicos libres para todo
# lo demás (salud, vivienda, política exterior...). Con pocos tópicos libres,
# los sembrados se "tragan" palabras ajenas. Tarda alrededor de 1 minuto.
set.seed(2026)                                   # >>> puede cambiarla en el Paso 7d
slda <- textmodel_seededlda(dtm, dictionary = dic, residual = 15)
saveRDS(slda, "slda_taller3.rds")   # guárdelo: lo necesitarán para reproducir sus cifras
# Para volver a cargarlo otro día sin estimarlo de nuevo:
# slda <- readRDS("slda_taller3.rds")
# ---- PASO 6 · Medir: ¿cuánto pesa cada tópico, en quién y cuándo? -------
theta <- slda$theta
gob   <- factor(docvars(dtm, "gobierno"), levels = orden_gob)
anio  <- docvars(dtm, "anio")
# a) Peso promedio (theta, en %) por gobierno
prev_gob <- aggregate(theta[, marcos, drop = FALSE], by = list(gobierno = gob), FUN = mean)
prev_gob[, marcos] <- round(prev_gob[, marcos] * 100, 1)
prev_gob
# b) % de párrafos cuyo tópico PRINCIPAL es cada uno de sus tópicos
principal <- topics(slda)
round(prop.table(table(gob, principal), 1)[, marcos] * 100, 1)
# b) % de párrafos cuyo tópico PRINCIPAL es cada uno de sus tópicos
principal <- topics(slda)
round(prop.table(table(gob, principal), 1)[, marcos] * 100, 1)
# b) % de párrafos cuyo tópico PRINCIPAL es cada uno de sus tópicos
principal <- topics(slda)
round(prop.table(table(gob, principal), 1)[, marcos] * 100, 1)
